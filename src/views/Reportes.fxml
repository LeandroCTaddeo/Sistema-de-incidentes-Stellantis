<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ReportesController"
            stylesheets="@../resources/css/admin.css"
            styleClass="reports-root">

    <top>
        <VBox spacing="12" styleClass="reports-header">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Reportes de incidentes"
                       styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCerrar" text="Cerrar" styleClass="button-secondary"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="filter-row">
                <Label text="Desde:"/>
                <DatePicker fx:id="dpDesde"/>
                <Label text="Hasta:"/>
                <DatePicker fx:id="dpHasta"/>
                <Button fx:id="btnActualizar" text="Actualizar"
                        styleClass="button-primary"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="reports-scroll">
            <VBox styleClass="reports-content">
                <HBox spacing="15">
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          styleClass="metric-card">
                        <Label text="Total de incidentes" styleClass="metric-label"/>
                        <Label fx:id="lblTotal" text="0" styleClass="metric-value"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          styleClass="metric-card">
                        <Label text="Pendientes" styleClass="metric-label"/>
                        <Label fx:id="lblPendientes" text="0" styleClass="metric-value,metric-danger"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          styleClass="metric-card">
                        <Label text="Resueltos" styleClass="metric-label"/>
                        <Label fx:id="lblResueltos" text="0" styleClass="metric-value,metric-success"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          styleClass="metric-card">
                        <Label text="Tiempo promedio de resolución" styleClass="metric-label"/>
                        <Label fx:id="lblTiempoPromedio" text="0 h" styleClass="metric-value"/>
                    </VBox>
                </HBox>

                <HBox spacing="18" styleClass="chart-card">
                    <BarChart fx:id="chartAreas" title="Incidentes por área o sector"
                              animated="false" HBox.hgrow="ALWAYS" prefHeight="430">
                        <xAxis><CategoryAxis label="Área / sector"/></xAxis>
                        <yAxis><NumberAxis label="Cantidad" forceZeroInRange="true"/></yAxis>
                    </BarChart>

                    <PieChart fx:id="chartPrioridades" title="Distribución por prioridad"
                              animated="false" legendVisible="true"
                              labelsVisible="false"
                              HBox.hgrow="ALWAYS" prefHeight="430"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
