<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.ReportesController"
            style="-fx-background-color:#f4f6f8;">

    <top>
        <VBox spacing="12" style="-fx-padding:18; -fx-background-color:white;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Reportes de incidentes"
                       style="-fx-font-size:26; -fx-font-weight:bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnCerrar" text="Cerrar"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Desde:"/>
                <DatePicker fx:id="dpDesde"/>
                <Label text="Hasta:"/>
                <DatePicker fx:id="dpHasta"/>
                <Button fx:id="btnActualizar" text="Actualizar"
                        style="-fx-background-color:#4e84cc; -fx-text-fill:white; -fx-font-weight:bold;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="18" style="-fx-padding:20;">
                <HBox spacing="15">
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white; -fx-padding:18; -fx-background-radius:10;">
                        <Label text="Total de incidentes" style="-fx-text-fill:#666;"/>
                        <Label fx:id="lblTotal" text="0" style="-fx-font-size:30; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white; -fx-padding:18; -fx-background-radius:10;">
                        <Label text="Pendientes" style="-fx-text-fill:#666;"/>
                        <Label fx:id="lblPendientes" text="0" style="-fx-font-size:30; -fx-font-weight:bold; -fx-text-fill:#d32f2f;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white; -fx-padding:18; -fx-background-radius:10;">
                        <Label text="Resueltos" style="-fx-text-fill:#666;"/>
                        <Label fx:id="lblResueltos" text="0" style="-fx-font-size:30; -fx-font-weight:bold; -fx-text-fill:#2e7d32;"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white; -fx-padding:18; -fx-background-radius:10;">
                        <Label text="Tiempo promedio de resolución" style="-fx-text-fill:#666;"/>
                        <Label fx:id="lblTiempoPromedio" text="0 h" style="-fx-font-size:30; -fx-font-weight:bold;"/>
                    </VBox>
                </HBox>

                <HBox spacing="18">
                    <BarChart fx:id="chartAreas" title="Incidentes por área o sector"
                              animated="false" HBox.hgrow="ALWAYS" prefHeight="430">
                        <xAxis><CategoryAxis label="Área / sector"/></xAxis>
                        <yAxis><NumberAxis label="Cantidad" forceZeroInRange="true"/></yAxis>
                    </BarChart>

                    <PieChart fx:id="chartPrioridades" title="Distribución por prioridad"
                              animated="false" legendVisible="true"
                              labelsVisible="false"
                              HBox.hgrow="ALWAYS" prefHeight="430"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
