<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.AdministradorController"
            stylesheets="@../resources/css/admin.css"
            styleClass="admin-root">

    <left>

        <VBox prefWidth="220" minWidth="220" maxWidth="220" styleClass="sidebar">

            <Label text="STELLANTIS" styleClass="brand-title"/>

            <Separator/>

            <Button fx:id="btnBandeja" text="📥 Bandeja"
                    maxWidth="999" styleClass="nav-button,nav-button-active"/>

            <Button fx:id="btnMisCasos" text="🗂 Mis casos"
                    maxWidth="999" styleClass="nav-button"/>

            <Button fx:id="btnHistorial" text="📁 Historial"
                    maxWidth="999" styleClass="nav-button"/>

            <Button fx:id="btnReportes" text="📊 Reportes"
                    maxWidth="999" styleClass="nav-button"/>

            <Button fx:id="btnUsuarios" text="👥 Administradores"
                    maxWidth="999" styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="lblUsuarioActual" text="Administrador" styleClass="sidebar-user"/>

        </VBox>

    </left>

    <center>

        <BorderPane>

            <top>

                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="topbar">

                    <Label fx:id="lblSeccion" text="Bandeja de Incidentes"
                           styleClass="page-title"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox fx:id="filtrosFechas" spacing="6" alignment="CENTER_LEFT"
                          styleClass="filter-row"
                          visible="false" managed="false">
                        <Label text="Desde:"/>
                        <DatePicker fx:id="dpDesde" prefWidth="140"/>
                        <Label text="Hasta:"/>
                        <DatePicker fx:id="dpHasta" prefWidth="140"/>
                    </HBox>

                    <TextField fx:id="txtBuscar" promptText="Buscar..."
                               prefWidth="250"/>

                </HBox>

            </top>

            <center>

                <SplitPane dividerPositions="0.34" styleClass="main-split">

                    <ScrollPane fitToWidth="true" styleClass="content-scroll">

                        <content>

                            <VBox fx:id="listaIncidentes"
                                  styleClass="incident-list"/>

                        </content>

                    </ScrollPane>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                                minWidth="0" styleClass="content-scroll">

                      <content>
                       <VBox styleClass="detail-panel">

                        <Label fx:id="lblTitulo"
                               text="Seleccione un incidente"
                               styleClass="detail-title"/>

                        <GridPane styleClass="detail-grid">

                            <Label text="Empleado" styleClass="field-label"/>
                            <Label fx:id="lblEmpleado" styleClass="field-value" GridPane.columnIndex="1"/>

                            <Label text="Sector" styleClass="field-label" GridPane.rowIndex="1"/>
                            <Label fx:id="lblSector"
                                   styleClass="field-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="1"/>

                            <Label text="Prioridad"
                                   styleClass="field-label"
                                   GridPane.rowIndex="2"/>

                            <Label fx:id="lblPrioridad"
                                   styleClass="field-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="2"/>

                            <Label text="Estado"
                                   styleClass="field-label"
                                   GridPane.rowIndex="3"/>

                            <Label fx:id="lblEstado"
                                   styleClass="field-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="3"/>

                            <Label text="Responsable"
                                   styleClass="field-label"
                                   GridPane.rowIndex="4"/>

                            <Label fx:id="lblResponsable"
                                   styleClass="field-value"
                                   GridPane.columnIndex="1"
                                   GridPane.rowIndex="4"/>

                        </GridPane>

                        <Label text="Descripción" styleClass="section-label"/>

                        <TextArea fx:id="txtDescripcion"
                                  editable="false"
                                  wrapText="true"
                                  prefHeight="280"/>

                        <Label text="Imágenes" styleClass="section-label"/>

                        <FlowPane fx:id="contenedorImagenes"
                                  hgap="10"
                                  vgap="10"
                                  minWidth="0"
                                  maxWidth="9999"
                                  prefWrapLength="600"/>

                        <HBox spacing="10">

                            <Region HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnTomarCaso"
                                    text="Tomar caso" styleClass="button-primary"/>

                            <Button fx:id="btnLiberarCaso"
                                    text="Liberar caso" styleClass="button-secondary"/>

                            <Button fx:id="btnResolver"
                                    text="Resolver" styleClass="button-success"/>

                            <Button fx:id="btnExportar"
                                    text="Exportar PDF" styleClass="button-secondary"/>

                        </HBox>

                       </VBox>
                      </content>
                    </ScrollPane>

                </SplitPane>

            </center>

        </BorderPane>

    </center>

</BorderPane>
