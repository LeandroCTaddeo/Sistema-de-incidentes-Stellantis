<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DetalleCasoAdminController"
            style="-fx-background-color:#f4f6f8;">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT"
              style="-fx-padding:15; -fx-background-color:white; -fx-border-color:#dcdcdc; -fx-border-width:0 0 1 0;">
            <Button fx:id="btnVolver" text="← Volver"/>
            <Label fx:id="lblTituloCaso"
                   text="Expediente"
                   style="-fx-font-size:24; -fx-font-weight:bold;"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.30">

            <VBox spacing="10"
                  style="-fx-padding:15; -fx-background-color:white;">

                <Label text="📁 Documentos del expediente"
                       style="-fx-font-size:20px; -fx-font-weight:bold;"/>

                <Button fx:id="btnBoletinOriginal"
                        maxWidth="9999"
                        text="📄 Boletín original del empleado"/>

                <VBox fx:id="contenedorBoletines"
                      spacing="8"/>

                <Separator/>

                <Button fx:id="btnNuevoBoletin"
                        maxWidth="9999"
                        text="➕ Nuevo boletín interno"/>

                <Button fx:id="btnExportar"
                        maxWidth="9999"
                        text="📄 Exportar expediente"/>

                <Button fx:id="btnResolver"
                        maxWidth="9999"
                        text="✔ Resolver caso"/>

            </VBox>

            <ScrollPane fitToWidth="true">
                <VBox fx:id="panelVistaPrevia"
                      spacing="12"
                      style="-fx-padding:20;">

                    <Label text="Seleccione un documento del expediente"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                </VBox>
            </ScrollPane>

        </SplitPane>
    </center>

</BorderPane>