<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DetalleCasoAdminController"
            stylesheets="@../resources/css/admin.css"
            styleClass="case-root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="case-topbar">
            <Button fx:id="btnVolver" text="← Volver" styleClass="button-secondary"/>
            <Label fx:id="lblTituloCaso"
                   text="Expediente"
                   styleClass="page-title"/>
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.30" styleClass="case-split">

            <VBox styleClass="case-sidebar">

                <Label text="📁 Documentos del expediente"
                       styleClass="case-sidebar-title"/>

                <Button fx:id="btnBoletinOriginal"
                        maxWidth="9999"
                        styleClass="document-button"
                        text="📄 Boletín original del empleado"/>

                <VBox fx:id="contenedorBoletines"
                      spacing="8"/>

                <Separator/>

                <Label fx:id="lblResponsableCaso"
                       text="Sin responsable"
                       styleClass="field-value"/>

                <Button fx:id="btnTomarCaso"
                        maxWidth="9999"
                        styleClass="button-primary"
                        text="Tomar caso"/>

                <Button fx:id="btnLiberarCaso"
                        maxWidth="9999"
                        styleClass="button-secondary"
                        text="Liberar caso"/>

                <Button fx:id="btnNuevoBoletin"
                        maxWidth="9999"
                        styleClass="button-primary"
                        text="➕ Nuevo boletín interno"/>

                <Button fx:id="btnExportar"
                        maxWidth="9999"
                        styleClass="button-secondary"
                        text="📄 Exportar expediente"/>

                <Button fx:id="btnResolver"
                        maxWidth="9999"
                        styleClass="button-success"
                        text="✔ Resolver caso"/>

            </VBox>

            <ScrollPane fitToWidth="true" styleClass="preview-scroll">
                <VBox fx:id="panelVistaPrevia"
                      styleClass="preview-panel">

                    <Label text="Seleccione un documento del expediente"
                           styleClass="case-sidebar-title"/>

                </VBox>
            </ScrollPane>

        </SplitPane>
    </center>

</BorderPane>
